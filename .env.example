# InnPilot environment.
#
# Copy to .env for local development (.env is git-ignored). Values for the
# deployed app go in your host's Environment Variables, not here.
#
# The VITE_ prefix is the dividing line: Vite bundles VITE_* into the
# public browser JS, so anything with that prefix is world-readable. The
# admin credentials below must never get one.

# --- Frontend (public — bundled into the browser) --------------------------

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# --- AI Concierge (secret — never prefixed with VITE_) ----------------------
#
# Read only by the Vercel functions under api/ (and by `npm run dev:api`
# locally). The browser bundle has no access to process.env, so the key
# never leaves the server. In production these live in the Vercel
# project's Environment Variables, not in any file.

# Which model service answers guests: groq (default) or gemini. DECISIONS D31.
AI_PROVIDER=groq

# Required for AI_PROVIDER=groq. Create one at https://console.groq.com/keys
GROQ_API_KEY=

# The model must be able to call tools (it reads hotels, prices and
# availability only through them). groq/compound and groq/compound-mini
# CANNOT: Groq rejects a request with tools on them (HTTP 400), and the
# gateway refuses them as a configuration error. Free-plan options that can:
# openai/gpt-oss-120b (default), openai/gpt-oss-20b, qwen/qwen3.8-27b.
GROQ_MODEL=openai/gpt-oss-120b

# Optional — sensible defaults are in server/ai/config.ts.
# GROQ_REASONING_EFFORT=low     # default "low" on gpt-oss models; unset elsewhere
# GROQ_MAX_OUTPUT_TOKENS=1024
# GROQ_TEMPERATURE=0.3
# GROQ_TIMEOUT_MS=25000         # a whole guest turn, tool calls included; keep below vercel.json maxDuration
# GROQ_BASE_URL=                # a proxy; unset uses Groq's API

# Required only for AI_PROVIDER=gemini. Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — sensible defaults are in server/ai/config.ts.
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_MAX_OUTPUT_TOKENS=1024
# GEMINI_TEMPERATURE=0.3
# GEMINI_TIMEOUT_MS=25000   # a whole guest turn, tool calls included; keep below vercel.json maxDuration
# GEMINI_BASE_URL=          # a proxy, or scripts/verify/fake-gemini.mjs (http://127.0.0.1:8787) for browser checks

# Optional. Only needed if the app is ever served from a different origin
# than the API. Unset means "same-origin only", which is the deployed
# setup: a wildcard here would let any site spend this deployment's tokens.
# ALLOWED_ORIGINS=https://example.com,https://www.example.com

# Optional. Port for `npm run dev:api`; vite.config.ts proxies /api here.
# DEV_API_PORT=3001

# Required for the concierge's tools (rooms, availability, bookings). The
# Vercel functions read and write Firestore through the Firebase Admin SDK,
# which bypasses firestore.rules — so this is a full-access key. Paste the
# service-account JSON (or base64 of it) into the host's secret store.
# Unset falls back to Application Default Credentials. Ignored when
# FIRESTORE_EMULATOR_HOST is set (local runs against the emulator).
FIREBASE_SERVICE_ACCOUNT=
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# --- Admin scripts (secret — never prefixed with VITE_) ---------------------
#
# Used only by `npm run migrate` (scripts/admin/),
# which runs on your machine against the Firebase Admin SDK. That SDK
# bypasses every rule in firestore.rules, so this key belongs in a secret
# store or a local .env — never in the repo, and never in the browser.
#
# Point at a downloaded service-account key file. Leave unset to fall back
# to Application Default Credentials (e.g. `gcloud auth application-default
# login`), which is what scripts/admin/lib/adminApp.ts does.
GOOGLE_APPLICATION_CREDENTIALS=

# Optional: overrides the project id in the key file.
FIREBASE_PROJECT_ID=
