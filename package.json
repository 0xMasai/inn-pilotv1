{
  "name": "hotel-management",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "electron/main.cjs",
  "author": "Felix Masai",
  "description": "InnPilot AI Concierge — search K Hotels properties and book a room in one conversation",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx server/dev-server.ts",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron": "electron .",
    "desktop": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "migrate": "tsx scripts/admin/migrate.ts",
    "test:rules": "vitest run tests/rules",
    "test:rules:watch": "vitest tests/rules",
    "test:unit": "vitest run tests/unit",
    "test:server": "vitest run tests/server",
    "test:all": "firebase emulators:exec --only firestore \"vitest run\"",
    "verify:live": "tsx scripts/verify/concierge-live.ts",
    "verify:vercel": "node scripts/verify/vercel-build.mjs",
    "verify:release": "npm run build && node scripts/verify/release-check.mjs",
    "seed:emulator": "tsx scripts/verify/seed-emulator-demo.ts",
    "seed:k-hotels": "tsx scripts/seed/k-hotels.ts",
    "electron:dev": "vite --port 5173"
  },
  "build": {
    "appId": "com.hotel.management",
    "productName": "InnPilot",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      }
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Office"
    },
    "copyright": "Copyright © 2026 Masai Labs",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "InnPilot"
    }
  },
  "dependencies": {
    "@google/genai": "^2.22.0",
    "@tailwindcss/vite": "^4.1.16",
    "@tippyjs/react": "^4.2.6",
    "firebase": "^12.4.0",
    "firebase-admin": "^14.3.0",
    "flatpickr": "^4.6.13",
    "framer-motion": "^12.23.24",
    "groq-sdk": "^1.6.0",
    "jspdf": "^3.0.4",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^0.487.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-flatpickr": "^4.0.11",
    "react-router-dom": "^7.9.4",
    "recharts": "^3.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.22",
    "dotenv": "^17.2.3",
    "electron": "^39.2.3",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "firebase-tools": "^15.28.2",
    "globals": "^16.4.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.23.12",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7",
    "vitest": "^4.1.11"
  }
}
