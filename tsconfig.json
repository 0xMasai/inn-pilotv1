{
  /* Solution file: `tsc -b` builds the three referenced projects, and this
     file compiles nothing itself ("files": []). But Vercel type-checks each
     api/ function against the nearest tsconfig.json, which is this one, and
     uses only these compilerOptions — not tsconfig.server.json's. Without
     "strict", `if (!x.ok)` no longer narrows the { ok: true } | { ok: false }
     results the server returns, and the deployment fails to build. */
  "compilerOptions": {
    "strict": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.node.json"
    },
    {
      "path": "./tsconfig.server.json"
    }
  ]
}
